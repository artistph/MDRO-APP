rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function usersDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function getUser() {
      return exists(usersDoc(request.auth.uid)) ? get(usersDoc(request.auth.uid)).data : null;
    }
    function isOwner() {
      return signedIn() && getUser() != null && getUser().role == 'owner';
    }
    function canWrite() {
      return signedIn() && getUser() != null && getUser().role in ['owner', 'editor'];
    }
    function ownerDoc() { return /databases/$(database)/documents/bootstrap/owner; }
    function ownerCodeDoc() { return /databases/$(database)/documents/bootstrap/owner-code; }

    // ===== بيانات تطبيق MDRO (البيانات الطبية) =====
    // القراءة لكل مستخدم مسجّل الدخول (الـ viewer يُشاهد التقارير فقط)،
    // والكتابة للمالك والمحرّر فقط عبر canWrite — حماية احترافية للبيانات.
    match /mdro_data/{doc} {
      allow read: if signedIn();
      allow write: if canWrite();
    }

    // ===== أجهزة الدخول والإشعارات (تسجيل جهاز جديد + FCM) =====
    // تُترك لكل جلسة مسجّلة لضمان عمل تسجيل الأجهزة وإشعارات الدفع.
    match /devices/{deviceId} {
      allow read, write: if request.auth != null;
    }

    // ===== الإعدادات (قراءة فقط من العملاء) =====
    match /mdro_config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ===== بيانات المعمل (LDM) =====
    // تُكتب من جسر المعمل عبر حساب الخدمة (يتجاوز القواعد)؛ العميل يقرأ فقط،
    // وأي كتابة من التطبيق محصورة في المالك والمحرّر.
    match /ldmCultures/{doc} {
      allow read: if request.auth != null;
      allow write: if canWrite();
    }

    // ===== طلب/تفعيل المالك (bootstrap) =====
    // إنشاء owner مسموح فقط إذا لم يكن ownerSet بعد (أول مالك يكتسب الملكية مرة واحدة).
    match /bootstrap/owner {
      allow get: if signedIn();
      allow list: if signedIn();
      allow update: if signedIn() && !get(ownerDoc()).data.ownerSet;
      allow create: if signedIn() && !exists(ownerDoc());
    }

    // ===== كود المالك =====
    match /bootstrap/owner-code {
      allow read, write: if isOwner();
    }

    // ===== المستخدمون والأدوار =====
    match /users/{uid} {
      allow read: if signedIn();
      // إنشاء حساب ممكن في الحالات:
      //  1) أول مالك: يخلق مستند owner ويُغلق bootstrap.owner (وضع ownerSet=false).
      //  2) المالك (isOwner) عبر createUser: request.resource.data.createdBy == request.auth.uid.
      //  3) حساب جديد يُنشأ عبر factory auth ببريد/كلمة سر الجديد، ومضمون الدور
      //     غير owner ومُعيّن من المالك (createdBy == owner-code.ownerUid).
      allow create: if (
        (request.resource.data.role == 'owner'
          && exists(ownerDoc())
          && !get(ownerDoc()).data.ownerSet)
        ||
        (isOwner() && request.resource.data.createdBy == request.auth.uid)
        ||
        (request.auth.uid == uid
          && request.resource.data.role != 'owner'
          && exists(ownerCodeDoc())
          && request.resource.data.createdBy
            == get(ownerCodeDoc()).data.ownerUid)
      );
      allow update, delete: if isOwner();
    }

    // ===== خريطة بريد الدخول ↔ UID (للحفاظ على البريد المستخدم للدخول) =====
    // القراءة عامة؛ الإنشاء للتسجيل أو المالك؛ التعديل/الحذف للمالك فقط.
    match /ic-login-map/{uid} {
      allow read: if true;
      allow create: if request.auth.uid == uid || isOwner();
      allow update, delete: if isOwner();
    }
  }
}